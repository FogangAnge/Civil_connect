# ===== CivilConnect (global) =====
PROJECT_NAME=CivilConnect

# ===== Frontend (Vite) =====
# Même hôte que le navigateur (évite perte de cookies entre localhost et 127.0.0.1)
VITE_API_URL=http://127.0.0.1:8000

# ===== Django =====
# Connexion démo sans étape MFA (désactiver en production)
DEMO_SKIP_MFA=1

# Code MFA « fixe » pour tests (si DJANGO_DEBUG=1 ou ALLOW_DEMO_MFA_BYPASS=1).
# Si la variable est absente et DEBUG=1 → défaut 888888 dans settings.
# Pour forcer la désactivation du bypass en local : définir DEMO_MFA_BYPASS_CODE vide.
# DEMO_MFA_BYPASS_CODE=888888

DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me-in-prod
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5174,http://localhost:3000
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5174,http://localhost:3000

# Cookies JWT (httpOnly) configurés côté backend
JWT_AUTH_COOKIE=cc_access
JWT_AUTH_REFRESH_COOKIE=cc_refresh

# ===== PostgreSQL =====
POSTGRES_DB=projet_dut
# Si tu tiens à garder un espace (ex: "Projet DUT"), il faut le créer côté Postgres
# avec des guillemets: CREATE DATABASE "Projet DUT";
# et en PowerShell: $env:POSTGRES_DB="Projet DUT"
POSTGRES_USER=civilconnect
POSTGRES_PASSWORD=civilconnect
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ===== Redis / Celery =====
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# AES-256 (base64) pour champs chiffrés (NIN, nom parents, etc.)
# Exemple: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
AES_KEY_B64=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# ===== OCR (Tesseract) =====
# Dans Docker, tesseract est installé dans l'image backend.
TESSERACT_CMD=/usr/bin/tesseract

# ===== MFA / SMS (exemples) =====
SMS_PROVIDER=mock
SMS_API_KEY=

